# Server
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# MongoDB
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/cutoffsaathi

# Auth
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=7d
COOKIE_SECRET=replace_with_another_long_random_string

# Razorpay
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxx
SHEET_PRICE_PAISE=9900

# Admin bootstrap (used only by seed script)
ADMIN_EMAIL=admin@cutoffsaathi.in
ADMIN_PASSWORD=admin@123

# Email (OTP verification) — Gmail SMTP shown here; any SMTP provider works
# the same way (just change host/port). See README section "Email OTP setup".
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=youraddress@gmail.com
SMTP_PASS=your_16_char_app_password
EMAIL_FROM="CutoffSaathi <youraddress@gmail.com>"
OTP_EXPIRES_MINUTES=10
